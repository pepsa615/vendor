{
  "name": "@pepsa/vendor-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && pnpm bundle:check",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --config playwright.ui-kit.config.ts",
    "contracts:generate": "openapi-typescript contracts/openapi.json -o src/api/generated/schema.ts",
    "contracts:check": "node scripts/check-contract.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "docs:check": "node scripts/check-governance.mjs",
    "verify": "pnpm docs:check && pnpm contracts:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check",
    "preview": "vite preview",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
