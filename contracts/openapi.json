  "info": {
    "title": "Pepsa Vendor API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PublicOrderLinkDto": {
        "type": "object",
        "properties": {
          "publicSlug": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "VENDOR_NOT_APPROVED",
                "PRICING_NOT_CONFIGURED",
                "PAYMENT_NOT_READY"
              ]
            }
          }
        },
        "required": [
          "publicSlug",
          "path",
          "enabled",
          "blockers"
        ]
      },
      "VendorProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
